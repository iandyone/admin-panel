{
  "extends": "@configs/typescript",
  "compilerOptions": {
    "baseUrl": "./",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@pw/*": ["./playwright/*"],
      "@pw/objects/*": ["./playwright/page-objects/*"],
      "@pw/constants": ["./playwright/constants"],
      "@pw/types": ["./playwright/types"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**.d.ts",
    "app/(pages)/forbidden.ts",
    "playwright/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
